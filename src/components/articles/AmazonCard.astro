---
import productLedger from "@/data/amazonProducts.json";

interface Props {
  title: string;
  shortUrl?: string;
  asin?: string;
  image?: string;
}

interface Product {
  title: string;
  image: string;
}

const products = productLedger as Record<string, Product>;

const {
  title: inputTitle,
  image: inputImage,
  shortUrl,
  asin: inputAsin,
} = Astro.props;

const productId = shortUrl?.trim();
const product = productId ? products[productId] : undefined;

const title = product?.title || inputTitle?.trim();
const image = inputImage?.trim() || product?.image;

let url: URL;

if (productId) {
  url = new URL(productId);

  if (
    url.protocol !== "https:" ||
    !["link.amazon", "amzn.to"].includes(url.hostname) ||
    url.username ||
    url.password
  ) {
    throw new Error("AmazonCard: Amazonの短縮URLを確認してください");
  }
} else {
  const asin = inputAsin?.trim().toUpperCase();
  const tag = import.meta.env.PUBLIC_AMAZON_ASSOCIATE_TAG?.trim();

  if (!asin || !/^[A-Z0-9]{10}$/.test(asin)) {
    throw new Error("AmazonCard: 短縮URLまたは正しいASINが必要です");
  }

  if (!tag) {
    throw new Error(
      "AmazonCard: PUBLIC_AMAZON_ASSOCIATE_TAG が設定されていません"
    );
  }

  url = new URL(`https://www.amazon.co.jp/dp/${asin}/`);
  url.searchParams.set("tag", tag);
}

if (!title) {
  throw new Error("AmazonCard: タイトルがありません");
}

if (!image) {
  throw new Error(
    `AmazonCard: 商品画像が台帳に登録されていません: ${productId}`
  );
}
---

<div class="amazon-product-card not-prose">
  <a
    href={url.toString()}
    rel="sponsored"
    class="amazon-product-link image-link"
    aria-label={title}
  >
    <div class="amazon-product-image-area">
      <img
        src={image}
        alt={title}
        class="amazon-product-image"
        loading="lazy"
        decoding="async"
      />
    </div>
    <span class="amazon-product-title" title={title}>{title}</span>
  </a>
</div>

<style>
  .amazon-product-card {
    box-sizing: border-box;
    display: block;
    width: calc(46% - 3rem);
    margin: 1.5rem auto;
    vertical-align: top;
    border: 1px solid #eee8e6;
    border-radius: 0.5rem;
    background: #fff;
    overflow: hidden;
  }

  /* 連続する2枚は横並びにし、組として中央へ寄せる。 */
  .amazon-product-card:has(+ .amazon-product-card),
  .amazon-product-card + .amazon-product-card {
    display: inline-block;
    margin-right: 1%;
    margin-left: 1%;
  }

  .amazon-product-card:has(+ .amazon-product-card):not(.amazon-product-card + .amazon-product-card) {
    margin-left: calc(2% + 3rem);
  }

  .amazon-product-card + .amazon-product-card:not(:has(+ .amazon-product-card)) {
    margin-right: calc(2% + 3rem);
  }

  .amazon-product-card .amazon-product-link {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    width: 100%;
    padding: 1rem;
    color: #6a6a6a;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .amazon-product-card .amazon-product-link:hover {
    background-color: #fafafa;
  }

  .amazon-product-card .amazon-product-link:focus-visible {
    outline: 2px solid #82a0aa;
    outline-offset: -3px;
  }

  /* 以前の196pxから約1.3倍。 */
  .amazon-product-image-area {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 15.925rem;
    min-width: 0;
  }

  .amazon-product-card .amazon-product-image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    border-radius: 0;
    object-fit: contain;
  }

  .amazon-product-card .amazon-product-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    height: 3.2em;
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    text-align: center;
    overflow-wrap: anywhere;
  }

  @media (max-width: 480px) {
    .amazon-product-card .amazon-product-link {
      padding: 0.75rem;
      gap: 0.75rem;
    }

    .amazon-product-card .amazon-product-title {
      font-size: 0.875rem;
    }
  }
</style>

